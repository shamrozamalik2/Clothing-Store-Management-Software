<?xml version="1.0" encoding="utf-8"?>
<!-- Gradient card + a soft off-canvas highlight circle bleeding from the
     top-left corner, for a bit of depth instead of a flat color fill.
     RemoteViews can't do real blur, so the "softness" comes from low
     opacity + the shape being mostly clipped off-canvas, not a blur. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="135"
                android:startColor="#2E71F7"
                android:endColor="#15337A" />
        </shape>
    </item>
    <item
        android:width="180dp"
        android:height="180dp"
        android:left="-70dp"
        android:top="-90dp"
        android:gravity="top|left">
        <shape android:shape="oval">
            <solid android:color="#1AFFFFFF" />
        </shape>
    </item>
</layer-list>
